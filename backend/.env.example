# =====================================================================
# Rekishi Forensics - Multi-Modal AI Engine Configuration
# Automatic Waterfall Failover: Groq -> Gemini -> Nvidia NIM -> Featherless -> Offline Engine
# =====================================================================

# --- 1. Groq Cloud (Primary for ultra-fast reasoning & Whisper transcription) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# --- 2. Google Gemini (First fallback for multi-modal reasoning & vision) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- 3. NVIDIA NIM Cloud (Second fallback for high-throughput LLaMA models) ---
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- 4. Featherless AI (Third fallback for open-weights vision & reasoning) ---
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct
FEATHERLESS_VLM_MODEL=Qwen/Qwen2-VL-7B-Instruct
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# --- Server Port & Host ---
PORT=8000
HOST=0.0.0.0
